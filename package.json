{
  "name": "renew-recovery",
  "version": "1.0.0",
  "description": "Recover — Agentic AI Revenue Recovery Tool for Subscription Businesses",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "setup": "npm install && npm --prefix client install",
    "test:backend": "node test/backend.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "author": "",
  "license": "MIT"
}
